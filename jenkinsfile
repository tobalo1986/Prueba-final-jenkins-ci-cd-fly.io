pipeline {
    agent any

    environment {
        FLY_API_TOKEN = credentials('fly_api_token') 
    }

    tools {
        nodejs 'NodeJS 16' 
    }

    triggers {
        githubPush() 
    }

    stages {
        stage('Install Flyctl') {
            steps {
                echo 'Installing Flyctl...'
                sh '''
                    # Descargar e instalar flyctl si no está disponible
                    curl -L https://fly.io/install.sh | sh
                    export PATH=$HOME/.fly/bin:$PATH
                '''
            }
        }

        stage('Install dependencies') {
            steps {
                echo 'Installing dependencies...'
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            steps {
                echo 'Running tests...'
                sh 'npm test'
            }
        }

        stage('Deploy to Fly.io') {
            steps {
                echo 'Deploying the project to Fly.io...'
                sh '''
                    # Desplegar la aplicación en Fly.io
                    flyctl auth token $FLY_API_TOKEN
                    flyctl deploy --app prueba-final-jenkins-ci-cd-fly-io --remote-only
                '''
            }
        }
    }

    post {
        success {
            echo '¡Despliegue exitoso!'
        }
        failure {
            echo 'Hubo un fallo en el pipeline.'
        }
    }
}

