pipeline {
    agent any

    environment {
        FLY_API_TOKEN = credentials('fly_api_token')
    }

    tools {
        nodejs 'NodeJS 16'     
    }

    triggers {
        githubPush()  // Este trigger monitorea cualquier push en el repositorio
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'deploy-jenkins', url: 'https://github.com/tobalo1986/Prueba-final-jenkins-ci-cd-fly.io.git'
            }
        }

        stage('Install dependencies') {
            when { branch 'deploy-jenkins' }  
            
            steps {
                echo 'Installing dependencies...'
                sh 'npm install'
            }
        }

        stage('Run Tests') {
            when { branch 'deploy-jenkins' }
            steps {
                echo 'Running tests...'
                sh 'npm run test'
            }
        }

        stage('Deploy to Fly.io') {
            when { branch 'deploy-jenkins' }
            steps {
                echo 'Deploying the project to Fly.io...'
                sh '''
                    flyctl auth token $FLY_API_TOKEN
                    flyctl deploy --app prueba-final-jenkins-ci-cd-fly-io --remote-only
                '''
            }
        }
    }

    post {
        success {
            echo '¡Despliegue exitoso!'
        }
        failure {
            echo 'Hubo un fallo en el pipeline.'
        }
    }
}
